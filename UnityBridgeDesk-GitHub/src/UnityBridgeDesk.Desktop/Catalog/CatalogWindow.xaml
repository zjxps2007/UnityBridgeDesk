<Window x:Class="UnityBridgeDesk.Desktop.Catalog.CatalogWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="프로젝트 · 버전 보관함" Width="1000" Height="760" MinWidth="740" MinHeight="540"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}"
 FontFamily="Malgun Gothic, Segoe UI" FontSize="12" Closing="CatalogClosing">
 <Window.Resources>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="20,10" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="Background" Value="{DynamicResource Tint}" /></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource Tint}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,6,0,12" /><Setter Property="MinHeight" Value="34" /></Style>
  <DataTemplate x:Key="CatalogRow">
   <StackPanel Margin="9,10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" /></StackPanel>
  </DataTemplate>
  <Style x:Key="DetailBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="True" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Background" Value="{DynamicResource Tint}" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,12,0,12" /></Style>
 </Window.Resources>
 <Grid Margin="24,20" Background="{DynamicResource Paper}">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="COLLECTION / SHARED TARGETS" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentInk}" /><TextBlock Text="프로젝트와 버전을 꺼내 두세요." FontSize="25" FontWeight="SemiBold" Margin="0,7,0,6" /><TextBlock Text="세 도구가 함께 쓰는 보관함 · 선택은 새 작업에 반영되고, 진행 중 작업의 대상은 유지돼요." Style="{StaticResource MutedText}" /></StackPanel>
  <TextBlock x:Name="StorageNotice" Grid.Row="1" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,12" />
  <TabControl x:Name="Tabs" Grid.Row="2" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}">
   <TabItem Header="빠른 설정">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
     <TextBlock Text="찾아 둔 항목에서 고르세요." FontSize="19" FontWeight="SemiBold" />
     <TextBlock Text="Unity Hub의 최근 프로젝트, 기본 설치 위치, 이전에 지정한 폴더를 확인합니다." Style="{StaticResource MutedText}" Margin="0,8,0,12" />
     <WrapPanel><Button x:Name="DiscoverRefresh" Content="다시 찾기" Click="DiscoverAgain" Margin="0,0,8,8" /><Button x:Name="DiscoverFolder" Content="다른 위치의 폴더 추가" Click="AddDiscoveryFolder" Margin="0,0,8,8" /></WrapPanel>
     <TextBlock x:Name="DiscoveryStatus" Text="로컬 항목을 찾는 중…" Style="{StaticResource MutedText}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
     <ListBox x:Name="DiscoveredItems" MinHeight="110" MaxHeight="220" ItemTemplate="{StaticResource CatalogRow}" SelectionChanged="DiscoverySelected" AutomationProperties.Name="자동으로 찾은 프로젝트와 Bridge 조합" />
     <TextBlock x:Name="DiscoveryDetail" TextWrapping="Wrap" Margin="0,12,0,12" FontSize="11" />
     <Button x:Name="UseDiscovered" Content="선택한 항목 사용" Click="UseDiscovery" HorizontalAlignment="Left" Background="{DynamicResource Accent}" IsEnabled="False" />
     <TextBlock Text="목록에 없으면 프로젝트 또는 압축을 푼 Bridge 폴더를 추가하세요. 지정한 위치는 다음에도 기억합니다. 파일별 지정과 비교 조합 변경은 옆 탭에서 할 수 있습니다." Style="{StaticResource MutedText}" FontSize="11" Margin="0,14,0,0" />
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="01  프로젝트">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <ListBox x:Name="Projects" ItemTemplate="{StaticResource CatalogRow}" SelectionChanged="ProjectChanged" AutomationProperties.Name="등록 프로젝트 목록" />
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Expander x:Name="ProjectForm" Header="새 프로젝트 등록" IsExpanded="True" Foreground="{DynamicResource AccentInk}" FontSize="13"><StackPanel Margin="0,10,0,12">
      <TextBlock Text="프로젝트 폴더" Margin="0,12,0,5" /><DockPanel><Button Content="찾아보기" DockPanel.Dock="Right" Click="BrowseProject" Margin="8,0,0,0" /><TextBox x:Name="ProjectPath" AutomationProperties.Name="프로젝트 폴더 경로" MaxLength="32760" /></DockPanel>
      <TextBlock Text="표시 이름 (선택)" Margin="0,9,0,5" /><TextBox x:Name="ProjectLabel" MaxLength="120" AutomationProperties.Name="프로젝트 표시 이름" />
      <Button Content="프로젝트 등록" Click="AddProject" HorizontalAlignment="Left" Margin="0,12,0,0" Background="{DynamicResource Accent}" />
      </StackPanel></Expander>
      <TextBlock Text="등록한 프로젝트" FontWeight="SemiBold" Margin="0,24,0,0" />
      <WrapPanel x:Name="ProjectActions"><Button Content="공통 대상으로 선택" Click="SelectProject" Background="{DynamicResource Accent}" Margin="0,0,8,8" /><Button Content="다시 확인" Click="RefreshProject" Margin="0,0,8,8" /><Button Content="경로 다시 지정" Click="RelocateProject" Margin="0,0,8,8" /><Button Content="목록에서 제거" Click="RemoveProject" Margin="0,0,8,8" /></WrapPanel>
      <TextBox x:Name="ProjectDetail" Style="{StaticResource DetailBox}" AutomationProperties.Name="프로젝트 확인 정보" />
      <TextBlock Text="목록에서 제거해도 프로젝트 폴더는 삭제되지 않아요. 경로를 다시 지정할 때에는 같은 프로젝트인지 직접 확인해 주세요." Style="{StaticResource MutedText}" FontSize="11" />
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="02  로컬 파일">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <ListBox x:Name="Artifacts" ItemTemplate="{StaticResource CatalogRow}" SelectionChanged="ArtifactChanged" AutomationProperties.Name="등록 파일 목록" />
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Expander x:Name="ArtifactForm" Header="새 CLI · Connector 등록" IsExpanded="True" Foreground="{DynamicResource AccentInk}" FontSize="13"><StackPanel Margin="0,10,0,12">
      <ComboBox x:Name="ArtifactType" SelectedIndex="0" AutomationProperties.Name="등록 파일 종류"><ComboBoxItem Content="CLI — Windows 실행 파일 (.exe)" /><ComboBoxItem Content="Connector — package.json이 있는 폴더" /></ComboBox>
      <TextBlock Text="로컬 경로" Margin="0,0,0,5" /><DockPanel><Button Content="찾아보기" DockPanel.Dock="Right" Click="BrowseArtifact" Margin="8,0,0,0" /><TextBox x:Name="ArtifactPath" MaxLength="32760" AutomationProperties.Name="로컬 파일 경로" /></DockPanel>
      <TextBlock Text="표시 이름 (선택)" Margin="0,9,0,5" /><TextBox x:Name="ArtifactLabel" MaxLength="120" AutomationProperties.Name="파일 표시 이름" />
      <Button Content="파일 정보 등록" Click="AddArtifact" HorizontalAlignment="Left" Margin="0,12,0,0" Background="{DynamicResource Accent}" />
      </StackPanel></Expander>
      <WrapPanel x:Name="ArtifactActions"><Button Content="다시 확인" Click="RefreshArtifact" Margin="0,0,8,8" /><Button Content="경로 다시 지정" Click="RelocateArtifact" Margin="0,0,8,8" /><Button Content="목록에서 제거" Click="RemoveArtifact" Margin="0,0,8,8" /></WrapPanel>
      <TextBox x:Name="ArtifactDetail" Style="{StaticResource DetailBox}" AutomationProperties.Name="파일 확인 정보" />
      <TextBlock Text="표시 이름과 파일 내부 버전은 별개예요. 파일을 실행하지 않고 읽기만 합니다. 폴더 해시는 .git을 제외한 파일 내용으로 계산해요." Style="{StaticResource MutedText}" FontSize="11" />
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="03  릴리스 조합">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <ListBox x:Name="Releases" ItemTemplate="{StaticResource CatalogRow}" SelectionChanged="ReleaseChanged" AutomationProperties.Name="릴리스 조합 목록" />
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Expander x:Name="ReleaseForm" Header="새 릴리스 조합 만들기" IsExpanded="True" Foreground="{DynamicResource AccentInk}" FontSize="13"><StackPanel Margin="0,10,0,12">
      <TextBlock Text="조합의 표시 이름" Margin="0,12,0,5" /><TextBox x:Name="ReleaseLabel" MaxLength="120" AutomationProperties.Name="릴리스 표시 이름" />
      <TextBlock Text="CLI" Margin="0,10,0,0" /><ComboBox x:Name="ReleaseCli" DisplayMemberPath="Title" AutomationProperties.Name="조합 CLI" />
      <TextBlock Text="Connector (선택)" /><ComboBox x:Name="ReleaseConnector" DisplayMemberPath="Title" AutomationProperties.Name="조합 Connector" />
      <TextBlock Text="비교 축" /><ComboBox x:Name="Axis" SelectedIndex="0" AutomationProperties.Name="비교 축"><ComboBoxItem Content="아직 정하지 않음" /><ComboBoxItem Content="CLI 전용 비교" /><ComboBoxItem Content="CLI + Connector 조합 비교" /></ComboBox>
      <TextBlock Text="CLI 전용 비교에서는 Connector 조건을 동일하게 고정해야 해요. 이곳의 선택은 조합 메모이며 실제 비교 조건 검사는 벤치 설정에서 연결됩니다." Style="{StaticResource MutedText}" FontSize="11" />
      <Button Content="릴리스 조합 등록" Click="AddRelease" HorizontalAlignment="Left" Margin="0,12,0,0" Background="{DynamicResource Accent}" />
      </StackPanel></Expander>
      <WrapPanel x:Name="ReleaseActions"><Button Content="참고 릴리스로 선택" Click="SelectRelease" Background="{DynamicResource Accent}" Margin="0,0,8,8" /><Button Content="목록에서 제거" Click="RemoveRelease" Margin="0,0,8,8" /></WrapPanel>
      <TextBox x:Name="ReleaseDetail" Style="{StaticResource DetailBox}" AutomationProperties.Name="릴리스 확인 정보" />
      <TextBlock Text="참고 릴리스를 선택해도 프로젝트의 설치 버전은 바뀌지 않아요." Style="{StaticResource MutedText}" FontSize="11" />
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="항목을 등록하거나 목록에서 골라 주세요." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.LiveSetting="Polite" /><Button Grid.Column="1" x:Name="Done" Content="작업실로 돌아가기" Click="CloseClick" IsCancel="True" ToolTip="Esc · 작업실로 돌아가기" /></Grid>
 </Grid>
</Window>
