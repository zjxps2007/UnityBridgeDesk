           <Expander Header="측정 조건과 해석" Margin="0,6,0,0">
            <StackPanel>
             <TextBlock Text="위 평균 차이는 양쪽 모두 유효한 같은 블록을 비교한 관찰값입니다. 그래프는 각 대상의 전체 유효 시행 평균이므로 서로 다를 수 있습니다. 한 블록은 반복 간 변동을 확인할 수 없습니다." Style="{StaticResource Hint}" />
             <TextBlock x:Name="ConditionProtocol" Style="{StaticResource Hint}" Margin="0,0,0,4" FontSize="11" LineHeight="17" />
             <TextBlock x:Name="ChartHint" Style="{StaticResource Hint}" />
            </StackPanel>
           </Expander>
          </StackPanel>
