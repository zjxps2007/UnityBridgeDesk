<Window x:Class="UnityBridgeDesk.Desktop.SpeedBenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="UnityBridge Desk · 로컬 속도 벤치" Icon="Assets/desk.ico" Width="1280" Height="880" MinWidth="960" MinHeight="660"
 WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic, Segoe UI" FontSize="12" Background="{DynamicResource Paper}"
 Loaded="WindowLoaded" Closing="WindowClosing">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Paper}" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="20" /><Setter Property="Margin" Value="0,0,0,14" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,10" /><Setter Property="LineHeight" Value="20" /></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Paper}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="RowHeight" Value="30" /><Setter Property="ColumnHeaderHeight" Value="32" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource Tint}" /><Setter Property="CanUserResizeRows" Value="False" /></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Tint}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /><Setter Property="Padding" Value="7,4" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style x:Key="ReportCellText" TargetType="TextBlock"><Setter Property="Margin" Value="7,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
 </Window.Resources>
 <Grid>
  <Grid.Background><ImageBrush ImageSource="Assets/cloud-station.png" Stretch="UniformToFill" /></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>
  <Border Background="{DynamicResource Paper}" Padding="24,12">
   <DockPanel><Button DockPanel.Dock="Right" Content="테마 변경" Click="ThemeClicked" /><Image Source="Assets/desk.ico" Width="30" Height="30" Margin="0,0,12,0" HorizontalAlignment="Left" /><StackPanel><TextBlock Text="BRIDGE DESK" FontFamily="Consolas" FontSize="16" /><TextBlock Text="같은 환경 · 같은 명령 · 버전별 속도 비교" Foreground="{DynamicResource Muted}" /></StackPanel></DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="24,18,24,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
   <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0,14,0,0" ItemContainerStyle="{StaticResource SelectionTab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <TabItem Header="1  준비" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><DockPanel>
     <Border DockPanel.Dock="Bottom" Background="{DynamicResource Paper}" CornerRadius="12" Padding="12" Margin="0,10,12,0">
      <Button Content="벤치 시작" Click="RunClicked" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsEnabled, ElementName=PreparationForm}" AutomationProperties.AutomationId="LocalBenchmarkStart" />
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
     <StackPanel x:Name="PreparationForm">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="비교할 릴리스" Style="{StaticResource Heading}" />
       <TextBlock Text="정식·RC 릴리스를 함께 비교할 수 있습니다. 두 개 이상 선택하면 CLI·필요한 런타임·Connector를 앱이 받아 검증합니다." Style="{StaticResource Hint}" />
       <WrapPanel><Button Content="릴리스 새로 확인" Click="ReleasesClicked" Margin="0,0,8,8" /><Button Content="선택한 파일 준비" Click="PrepareReleasesClicked" Margin="0,0,8,8" /></WrapPanel>
       <TextBlock x:Name="ReleaseStatus" Text="아직 조회한 릴리스가 없습니다." Style="{StaticResource Hint}" />
       <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ReleaseList" /></ScrollViewer>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="이 PC의 Unity" Style="{StaticResource Heading}" />
       <TextBlock x:Name="EditorStatus" Text="설치된 Unity를 찾고 있습니다." Style="{StaticResource Hint}" />
       <ComboBox x:Name="EditorList" DisplayMemberPath="Label" ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}" MinHeight="36" Margin="0,0,0,12" AutomationProperties.Name="실험에 사용할 Unity" />
       <WrapPanel><Button Content="Unity 다시 찾기" Click="FindEditorsClicked" Margin="0,0,8,8" /><Button Content="실행 파일 선택" Click="BrowseEditorClicked" Margin="0,0,8,8" /></WrapPanel>
       <TextBlock Text="설치·활성화된 Unity를 사용합니다. 새 임시 프로젝트에서 측정하고 결과 저장 후 정리합니다." Style="{StaticResource Hint}" />
       <Expander Header="실험 공간은 어떻게 분리되나요?"><TextBlock Margin="0,10,0,0" Style="{StaticResource Hint}" Text="매번 프로젝트·임시 파일·패키지 캐시를 새로 만들고 Unity·CLI를 새 프로세스로 실행합니다.&#10;Windows 설정·공용 서비스·시스템 캐시는 공유합니다. 첫 호출은 Unity 준비 후 첫 명령이며, PC 전체의 캐시가 비어 있다는 의미는 아닙니다." /></Expander>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <Expander Header="실험 조건 조정 · 첫 실행은 기본값으로 시작할 수 있어요"><StackPanel Margin="0,12,0,0">
       <CheckBox x:Name="F01" Content="F01  첫 호출 / 준비 이후 작은 요청" IsChecked="True" Margin="0,6,0,8" />
       <CheckBox x:Name="F02" Content="F02  같은 1,000개 이동을 1·10·100회로 분할" Margin="0,0,0,8" />
       <CheckBox x:Name="F03" Content="F03  1 KiB·64 KiB·1 MiB 응답" Margin="0,0,0,12" />
       <WrapPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="새 프로젝트 반복" /><TextBox x:Name="Repeats" Text="2" Margin="0,5,0,0" MinHeight="34" /></StackPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="준비 호출" /><TextBox x:Name="Warmups" Text="1" Margin="0,5,0,0" MinHeight="34" /></StackPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="준비 후 측정 호출" /><TextBox x:Name="Calls" Text="3" Margin="0,5,0,0" MinHeight="34" /></StackPanel></WrapPanel>
       <TextBlock Text="예비 시험(Pilot)입니다. 반복 호출을 독립 시행으로 세지 않으며, 작은 표본으로 승자를 판정하지 않습니다." Style="{StaticResource Hint}" />
       <Expander Header="시간 제한·실행 순서"><WrapPanel Margin="0,10,0,0"><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="CLI 제한(초)" /><TextBox x:Name="Timeout" Text="180" Margin="0,5,0,0" /></StackPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="Unity 준비(초)" /><TextBox x:Name="PrepareTimeout" Text="600" Margin="0,5,0,0" /></StackPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="순서 시드" /><TextBox x:Name="Seed" Text="20260915" Margin="0,5,0,0" /></StackPanel></WrapPanel></Expander>
       <Button x:Name="ResetButton" Content="벤치 설정 초기화" Click="ResetClicked" HorizontalAlignment="Left" Margin="0,12,0,0" />
       </StackPanel></Expander>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer></DockPanel></TabItem>
    <TabItem Header="2  진행" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Border Style="{StaticResource Card}" VerticalAlignment="Stretch"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="시험 진행" Style="{StaticResource Heading}" /><TextBlock Text="임시 프로젝트 준비 → Unity 실행 → 명령 측정 → 결과 저장·정리" Style="{StaticResource Hint}" /></StackPanel>
     <ProgressBar x:Name="Activity" Grid.Row="1" Height="6" Margin="0,0,0,18" IsIndeterminate="False" />
     <TextBox x:Name="Journal" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontFamily="Consolas, Malgun Gothic" />
    </Grid></Border></TabItem>
    <TabItem Header="3  결과" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
     <DockPanel Margin="0,0,10,0">
      <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16">
       <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="새로고침" Click="HistoryClicked" Margin="8,0,0,0" /><ComboBox x:Name="History" DisplayMemberPath="Label" SelectionChanged="HistorySelected" MinHeight="36" AutomationProperties.Name="저장된 시험 선택" /></DockPanel>
        <TextBlock x:Name="ResultStatus" Text="아직 시험 결과가 없습니다. 준비 탭에서 시작하세요." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,4" />
        <TextBox x:Name="ResultMemo" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0,3" FontSize="13" AutomationProperties.Name="결과 요약 메모" />
        <WrapPanel x:Name="ResultExportActions" IsEnabled="False" Margin="0,10,0,0">
         <Button Content="요약 복사" Click="CopySummaryClicked" Margin="0,0,8,4" />
         <Button Content="엑셀 열기" Click="ExcelClicked" Margin="0,0,8,4" />
         <Button Content="결과 폴더" Click="ResultsFolderClicked" Margin="0,0,8,4" />
        </WrapPanel>
        <TextBlock x:Name="ReportStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
       </StackPanel>
      </Border>
      <ScrollViewer x:Name="ResultDetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="조건별 시간" Style="{StaticResource Heading}" />
        <TextBlock Text="행을 선택하면 아래 시행 목록이 해당 조건으로 좁혀집니다. 제외에는 실패·중단·미수행이 포함됩니다." Style="{StaticResource Hint}" />
        <DataGrid x:Name="Summary" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="270" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="SummarySelected"><DataGrid.Columns>
         <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="실험" Binding="{Binding Experiment}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="조건" Binding="{Binding Condition}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="버전" Binding="{Binding Release}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="계획" Binding="{Binding Planned}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="유효" Binding="{Binding Valid}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="제외" Binding="{Binding Excluded}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="평균(ms)" Binding="{Binding Mean, StringFormat=N2, TargetNullValue=—}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="중앙값(ms)" Binding="{Binding Median, StringFormat=N2, TargetNullValue=—}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="단위" Binding="{Binding Unit}" />
        </DataGrid.Columns></DataGrid>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="기준 버전 대비 비교" Style="{StaticResource Heading}" />
        <TextBlock x:Name="Comparison" Text="두 버전이 모두 유효한 같은 블록만 비교합니다." Style="{StaticResource Hint}" />
        <DataGrid x:Name="PairSummary" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="260" HeadersVisibility="Column"><DataGrid.Columns>
         <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="실험" Binding="{Binding Experiment}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="조건" Binding="{Binding Condition}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="후보" Binding="{Binding Candidate}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="변화" Binding="{Binding Change}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="유효 블록" Binding="{Binding Blocks}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="기준(ms)" Binding="{Binding BaselineMs, StringFormat=N2, TargetNullValue=—}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="후보(ms)" Binding="{Binding CandidateMs, StringFormat=N2, TargetNullValue=—}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="단위" Binding="{Binding Unit}" />
        </DataGrid.Columns></DataGrid>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="시행 상세" Style="{StaticResource Heading}" />
        <WrapPanel Margin="0,6,0,8">
         <ComboBox x:Name="ExperimentFilter" MinWidth="110" MinHeight="34" Margin="0,0,8,6" SelectionChanged="TrialFilterChanged" AutomationProperties.Name="실험 필터" />
         <ComboBox x:Name="ReleaseFilter" MinWidth="130" MinHeight="34" Margin="0,0,8,6" SelectionChanged="TrialFilterChanged" AutomationProperties.Name="버전 필터" />
         <ComboBox x:Name="StatusFilter" MinWidth="120" MinHeight="34" Margin="0,0,8,6" SelectionChanged="TrialFilterChanged" AutomationProperties.Name="상태 필터">
          <ComboBoxItem Content="전체 상태" Tag="" /><ComboBoxItem Content="실패" Tag="failed" /><ComboBoxItem Content="중단" Tag="cancelled" /><ComboBoxItem Content="정리 실패" Tag="cleanup-failed" /><ComboBoxItem Content="미수행" Tag="not-run" /><ComboBoxItem Content="통계 제외" Tag="excluded" /><ComboBoxItem Content="성공" Tag="success" />
         </ComboBox>
         <Button Content="필터 초기화" Click="ClearFiltersClicked" Margin="0,0,0,6" />
        </WrapPanel>
        <TextBlock x:Name="TrialScope" Style="{StaticResource Hint}" />
        <DataGrid x:Name="Trials" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="250" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="TrialSelected"><DataGrid.Columns>
         <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="#" Binding="{Binding Order}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="블록" Binding="{Binding Block}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="버전" Binding="{Binding Release}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="실험" Binding="{Binding Experiment}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="조건" Binding="{Binding Condition}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="상태" Binding="{Binding Status}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="대표시간(ms)" Binding="{Binding WorkMs, StringFormat=N2, TargetNullValue=—}" /><DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="정리" Binding="{Binding Cleanup}" />
        </DataGrid.Columns></DataGrid>
        <TextBox x:Name="TrialDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" />
        <WrapPanel Margin="0,12,0,0"><Button x:Name="TrialFolderButton" IsEnabled="False" Content="선택 시행의 로그" Click="TrialFolderClicked" Margin="0,0,8,8" /><Button Content="원본 자료" Click="RawResultsFolderClicked" Margin="0,0,8,8" /><Button Content="이전 버전 기록 폴더" Click="LegacyFolderClicked" Margin="0,0,8,8" /></WrapPanel>
       </StackPanel></Border>
      </StackPanel></ScrollViewer>
     </DockPanel>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Column="1" Margin="22,6,0,0">
    <TextBlock x:Name="Clock" FontFamily="Segoe UI Light" FontSize="48" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" /><TextBlock x:Name="Date" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,24" />
    <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="지금 할 일" FontWeight="SemiBold" /><TextBlock x:Name="NextStep" Text="Unity를 찾고 릴리스를 준비합니다." Style="{StaticResource Hint}" /><TextBlock x:Name="State" Text="준비 대기" TextWrapping="Wrap" Foreground="{DynamicResource AccentInk}" /><Button x:Name="CancelButton" Content="중단하고 정리" Click="CancelClicked" Visibility="Collapsed" Margin="0,16,0,0" /></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="16"><StackPanel><Image x:Name="MascotImage" Source="Assets/desk.ico" Width="74" Height="74" Margin="0,4,0,10" RenderOptions.BitmapScalingMode="HighQuality" /><TextBlock Text="매번 새 프로젝트로 측정합니다.&#10;정리에 실패하면 다음 시행을 멈춥니다." Style="{StaticResource Hint}" /><TextBlock Text="파일·프로세스 분리 · Windows 공유" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{DynamicResource AccentInk}" /></StackPanel></Border>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource Paper}" Padding="24,8"><TextBlock Text="CLI + Connector 릴리스 비교 · local-cli-completion-v1-pilot · 환경 정보와 정리 상태 기록" Foreground="{DynamicResource Muted}" /></Border>
 </Grid>
</Window>
