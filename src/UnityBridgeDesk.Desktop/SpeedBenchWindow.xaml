             <Button x:Name="FollowupPlanButton" Content="이 기록으로 다음 실험 준비" Click="FollowupPlanClicked" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Margin="0,8,0,10" IsEnabled="False" />
             <TextBlock x:Name="FollowupStatus" Text="기록의 전체 조건·버전을 복원하고 가장 큰 권장 반복 수를 적용합니다. 모든 비교가 완료·유효해야 하며, 벤치는 직접 시작합니다." Style="{StaticResource Hint}" />
             <TextBlock x:Name="ReplicationDetail" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource Muted}" />
             <TextBlock Text="새 프로젝트 시행 순서" FontWeight="SemiBold" Margin="0,18,0,8" />
