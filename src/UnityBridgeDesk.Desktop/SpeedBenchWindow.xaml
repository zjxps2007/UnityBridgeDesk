         </UniformGrid>
         <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
          <StackPanel><CheckBox x:Name="AppearanceMotion" Content="화면과 캐릭터의 움직임 사용" Checked="AppearanceOptionsChanged" Unchecked="AppearanceOptionsChanged" /><TextBlock Text="끄면 화면 전환과 두 캐릭터가 정지합니다. Windows 애니메이션 설정을 따르며, 벤치 중에는 자동으로 멈춥니다." Style="{StaticResource Hint}" /></StackPanel>
         </Border>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="캐릭터" AutomationProperties.Name="아라와 아샤 설정">
       <ScrollViewer x:Name="AshaSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,20,26,16" Focusable="False">
        <StackPanel>
         <TextBlock Text="함께할 캐릭터" Style="{StaticResource Heading}" />
         <TextBlock Text="한 마리만 선택하거나 둘 다 불러오세요. 모두 끄면 캐릭터를 숨깁니다." Style="{StaticResource Hint}" />
         <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <DockPanel Height="68"><motion:DeskMascot Character="Cat" Width="64" Height="64" DockPanel.Dock="Right" IsHitTestVisible="False" Focusable="False" /><CheckBox x:Name="AppearanceCompanion" Content="아라 · 고양이" Checked="AppearanceOptionsChanged" Unchecked="AppearanceOptionsChanged" VerticalAlignment="Center" /></DockPanel>
           <TextBlock Text="높은 곳을 찾아 오릅니다. 시큰둥하게 바라보다 앞발로 장난칩니다." Style="{StaticResource Hint}" MinHeight="48" />
           <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel>
            <CheckBox x:Name="AppearanceRoaming" Content="스스로 탐색" Checked="AppearanceOptionsChanged" Unchecked="AppearanceOptionsChanged" />
            <DockPanel Margin="0,10,0,12"><ComboBox x:Name="AppearanceActivity" DockPanel.Dock="Right" Width="130" SelectionChanged="AppearanceOptionsChanged" AutomationProperties.Name="아라 활동량"><ComboBoxItem Content="얌전함" /><ComboBoxItem Content="보통" /><ComboBoxItem Content="활발함" /></ComboBox><TextBlock Text="활동량" VerticalAlignment="Center" /></DockPanel>
            <Button x:Name="AppearanceHomeButton" Content="아라를 처음 자리로" Click="CompanionHomeClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
           </StackPanel></Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <DockPanel Height="68"><motion:DeskMascot Character="Fox" Width="64" Height="64" DockPanel.Dock="Right" IsHitTestVisible="False" Focusable="False" /><CheckBox x:Name="AppearanceFox" Content="아샤 · 여우" Checked="AppearanceOptionsChanged" Unchecked="AppearanceOptionsChanged" VerticalAlignment="Center" /></DockPanel>
           <TextBlock Text="넓고 낮은 발판을 빠르게 돌아다닙니다. 냄새 맡듯 살피고 꼬리로 반응합니다." Style="{StaticResource Hint}" MinHeight="48" />
           <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel>
            <CheckBox x:Name="AppearanceFoxRoaming" Content="스스로 탐색" Checked="AppearanceOptionsChanged" Unchecked="AppearanceOptionsChanged" />
            <DockPanel Margin="0,10,0,12"><ComboBox x:Name="AppearanceFoxActivity" DockPanel.Dock="Right" Width="130" SelectionChanged="AppearanceOptionsChanged" AutomationProperties.Name="아샤 활동량"><ComboBoxItem Content="얌전함" /><ComboBoxItem Content="보통" /><ComboBoxItem Content="활발함" /></ComboBox><TextBlock Text="활동량" VerticalAlignment="Center" /></DockPanel>
            <Button x:Name="AppearanceFoxHome" Tag="fox" Content="아샤를 처음 자리로" Click="CompanionHomeClicked" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
           </StackPanel></Border>
          </StackPanel>
         </Grid>
         <TextBlock Text="끌어 놓으면 아래 발판에 착지합니다. 입력·스크롤 중에는 탐색을 쉬고, 벤치 중에는 둘 다 숨습니다." Style="{StaticResource Hint}" Margin="0,20,0,0" />
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="앱 관리" AutomationProperties.Name="앱 관리 설정">
       <ScrollViewer x:Name="AppSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,20,26,16" Focusable="False">
        <StackPanel>
         <TextBlock Text="기록과 앱 데이터" Style="{StaticResource Heading}" /><TextBlock Text="이전 방식의 기록과 앱 설정이 저장된 폴더를 엽니다. 현재 결과의 보고서는 결과 화면의 ‘내보내기’에서 확인하세요." Style="{StaticResource Hint}" />
         <Button Content="앱 데이터 폴더 열기" Click="LegacyFolderClicked" AutomationProperties.Name="이전 기록·앱 데이터 폴더 열기" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,4,0,24" />
         <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="최근 알림" Style="{StaticResource Heading}" /><TextBlock x:Name="LatestNotice" Text="새 알림이 없습니다." Style="{StaticResource Hint}" /></StackPanel></Border>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
     </TabControl>
     <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="26,14">
      <TextBlock x:Name="AppearanceStatus" Text="변경하면 바로 적용하고 저장합니다. · Esc로 닫기" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
     </Border>
    </Grid>
   </Border>
  </Grid>
</Grid>
</Window>

