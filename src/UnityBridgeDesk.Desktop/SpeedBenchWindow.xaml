<Window x:Class="UnityBridgeDesk.Desktop.SpeedBenchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UnityBridgeDesk.Desktop" xmlns:motion="clr-namespace:UnityBridgeDesk.Desktop.Controls" Title="UnityBridge Desk · 로컬 속도 벤치" Icon="Assets/desk.ico" Width="1440" Height="900" MinWidth="960" MinHeight="660" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Background="{DynamicResource Workspace}" UseLayoutRounding="True" Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/BenchControls.xaml" />
    <ResourceDictionary Source="Themes/BenchNavigation.xaml" />
    <ResourceDictionary Source="Themes/BenchWorkspace.xaml" />
   </ResourceDictionary.MergedDictionaries>
   <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,16,0,22" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0" />
   </Style>
   <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,6,0,10" />
    <Setter Property="LineHeight" Value="19" />
   </Style>
   <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="motion:AshaSurface.Edge" Value="Top" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
   </Style>
   <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Paper}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="RowHeight" Value="36" />
    <Setter Property="ColumnHeaderHeight" Value="36" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Workspace}" />
    <Setter Property="CanUserResizeRows" Value="False" />
   </Style>
   <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Tint}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="BorderThickness" Value="0" />
   </Style>
   <Style x:Key="NumberCell" TargetType="TextBlock">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Margin" Value="7,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Right" />
   </Style>
   <Style x:Key="ReportCellText" TargetType="TextBlock">
    <Setter Property="Margin" Value="7,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
   </Style>
   <Style x:Key="ActionMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="MenuItem">
       <Border x:Name="MenuSurface" CornerRadius="7" Background="Transparent">
        <Grid>
         <Border x:Name="Hover" CornerRadius="7" Background="{DynamicResource Tint}" Opacity="0" IsHitTestVisible="False" />
         <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
        </Grid>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
         <Setter TargetName="Hover" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
         <Setter Property="Opacity" Value="0.55" />
        </Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="ActionMenu" TargetType="ContextMenu">
    <EventSetter Event="Opened" Handler="ActionMenuOpened" />
    <EventSetter Event="PreviewKeyDown" Handler="ActionMenuPreviewKeyDown" />
    <Setter Property="Background" Value="{DynamicResource Paper}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="MinWidth" Value="240" />
    <Setter Property="FontFamily" Value="Malgun Gothic, Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ActionMenuItem}" />
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="ContextMenu">
       <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="5">
        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
       </Border>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="ActionSeparator" TargetType="Separator">
    <Setter Property="Height" Value="1" /><Setter Property="Margin" Value="12,5" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{DynamicResource Line}" Height="1" /></ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Background="{DynamicResource Workspace}">
 <Grid x:Name="WorkspaceSurface" SizeChanged="SurfaceSizeChanged" Background="{DynamicResource Workspace}">
  <Grid.RowDefinitions>
   <RowDefinition x:Name="HeaderRow" Height="104" />
   <RowDefinition Height="*" />
   <RowDefinition Height="30" />
  </Grid.RowDefinitions>
  <Border x:Name="WorkspaceHeader" motion:AshaSurface.Edge="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ClipToBounds="True">
   <Grid>
    <Image x:Name="LandscapeCover" Width="800" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-282,0,0" Stretch="UniformToFill" IsHitTestVisible="False" />
    <Border x:Name="CoverWash" IsHitTestVisible="False" />
    <DockPanel Margin="24,10">

           <ContentControl x:Name="MenuSlot" DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Center">
       <Button x:Name="ManagementMenuButton" Content="설정" Click="SettingsClicked" IsEnabled="False" AutomationProperties.Name="설정 열기" ToolTip="화면 · 캐릭터 · 앱 관리" Style="{StaticResource QuietButton}" />
      </ContentControl>
     <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="20,0,0,0" Background="{DynamicResource HeaderPaper}" CornerRadius="8" Padding="10,0"><StackPanel>
      <TextBlock x:Name="Clock" FontSize="30" FontFamily="Segoe UI" Foreground="{DynamicResource AccentInk}" />
      <TextBlock x:Name="Date" FontSize="10" MinHeight="14" Foreground="{DynamicResource Muted}" />
     </StackPanel></Border>
     <StackPanel DockPanel.Dock="Left" Width="214" VerticalAlignment="Center">
      <TextBlock Text="UnityBridge Desk" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Text="Unity 명령 성능 비교" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
     </StackPanel>
     <Button x:Name="CurrentRunShortcut" HorizontalAlignment="Left" Click="CurrentRunClicked" ToolTip="현재 실행으로 돌아가기" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" VerticalAlignment="Center" IsEnabled="False"><StackPanel>
      <TextBlock x:Name="SideActivity" Text="현재 실행 중인 벤치 없음" FontSize="12" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
       <TextBlock x:Name="SideProgress" Text="새 벤치를 준비하세요" FontSize="11" Foreground="{DynamicResource Muted}" />
       <TextBlock x:Name="Elapsed" Text="경과 00:00" FontSize="11" Foreground="{DynamicResource Muted}" Margin="16,0,0,0" />
      </StackPanel>
     </StackPanel></Button>
    </DockPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="SidebarColumn" Width="232" />
    <ColumnDefinition Width="*" />
   </Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Background="{DynamicResource NavigationSurface}" CornerRadius="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,8,16,12">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button x:Name="SidebarToggle" DockPanel.Dock="Right" Style="{StaticResource SidebarToggleButton}" Click="SidebarToggleClicked" ToolTip="탐색 목록 접기 · Alt+0" AutomationProperties.Name="탐색 목록 접기">
       <Grid Width="18" Height="18" IsHitTestVisible="False">
        <Path Data="M4,3.5 L14,3.5 Q15.5,3.5 15.5,5 L15.5,13 Q15.5,14.5 14,14.5 L4,14.5 Q2.5,14.5 2.5,13 L2.5,5 Q2.5,3.5 4,3.5 M7,3.5 L7,14.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeLineJoin="Round" />
        <Path x:Name="SidebarChevron" Data="{DynamicResource SidebarCollapseChevron}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
       </Grid>
      </Button>
      <TextBlock x:Name="NavigationTitle" Text="작업 공간" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
     </DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <Button x:Name="DraftShortcut" Click="DraftClicked" ToolTip="벤치 준비 · Ctrl+N" Style="{StaticResource NavigationButton}" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.3" Data="M2,1 L12,1 L16,5 L16,19 L2,19 Z M6,8 L12,8 M6,12 L12,12" /><TextBlock x:Name="DraftNavLabel" Text="벤치 준비" Margin="10,0,0,0" /></StackPanel></Button>
      <Button x:Name="RecordsShortcut" Click="RecordsClicked" ToolTip="실행 기록 · Ctrl+H" Style="{StaticResource NavigationButton}"><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.3" Data="M2,3 L16,3 L16,18 L2,18 Z M5,7 L13,7 M5,11 L13,11 M5,15 L10,15" /><TextBlock x:Name="RecordsNavLabel" Text="실행 기록" Margin="10,0,0,0" /></StackPanel></Button>
     </StackPanel>
     <Border x:Name="SidebarFooter" motion:AshaSurface.Edge="Top" DockPanel.Dock="Bottom" Margin="0,16,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <TextBlock x:Name="NextStep" Visibility="Collapsed" Text="Unity와 비교할 도구를 선택하세요." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
       <Border x:Name="CompanionHome" Grid.Column="1" Width="104" Height="104" IsHitTestVisible="False" />
      </Grid>
     </Border>
     <Grid x:Name="SidebarBody">
      <TextBlock x:Name="SidebarHeading" Text="준비 목차" FontSize="11" Foreground="{DynamicResource Muted}" Margin="6,0,0,0" VerticalAlignment="Top" />
      <StackPanel x:Name="PreparationIndex" Margin="0,26,0,0">
       
       <ListBox x:Name="PreparationLinks" Style="{StaticResource IndexList}" SelectionChanged="PreparationLinkSelected" AutomationProperties.Name="준비 설정 목차" PreviewMouseLeftButtonUp="PreparationLinkClicked" PreviewKeyDown="PreparationLinkKeyDown">
        <ListBoxItem Content="Unity 환경" Tag="EditorSection" />
        <ListBoxItem Content="비교 대상" Tag="ReleaseSection" />
        <ListBoxItem Content="실험 선택" Tag="ExperimentSection" />
        <ListBoxItem Content="실행 조건" Tag="ExecutionSection" />
       </ListBox>
       <TextBlock Text="항목을 선택하면 해당 설정으로 이동합니다." TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="8,20,8,0" />
      </StackPanel>
      <Grid x:Name="ProgressIndex" Margin="0,26,0,0" Visibility="Collapsed">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
       </Grid.RowDefinitions>
       <TextBlock Text="시행 찾기" Style="{StaticResource IndexCaption}" />
       <TextBox Height="36" MinHeight="36" x:Name="LiveSearch" Grid.Row="1" Margin="0,0,0,8" TextChanged="LiveFilterChanged" ToolTip="시행 번호·버전·실험 검색" AutomationProperties.Name="진행 시행 검색" />
       <ComboBox x:Name="LiveFilter" Grid.Row="2" Margin="0,0,0,8" SelectedIndex="0" SelectionChanged="LiveFilterChanged" AutomationProperties.Name="진행 시행 상태 필터">
        <ComboBoxItem Content="전체 시행" Tag="" />
        <ComboBoxItem Content="진행 중" Tag="running" />
        <ComboBoxItem Content="실패·정리 실패" Tag="failed" />
       </ComboBox>
       <ListBox x:Name="LiveTrialIndex" Grid.Row="3" Style="{StaticResource IndexList}" ItemTemplate="{StaticResource LiveIndexTemplate}" SelectionChanged="LiveTrialSelected" AutomationProperties.Name="진행 시행 목록" />
       <StackPanel Grid.Row="4">
        <TextBlock x:Name="LiveScope" Text="시작하면 시행 목록이 표시됩니다." TextWrapping="Wrap" Style="{StaticResource Hint}" FontSize="11" />
        <Button x:Name="FollowTrialButton" Content="현재 시행으로" Click="FollowTrialClicked" Style="{StaticResource QuietButton}" IsEnabled="False" />
       </StackPanel>
      </Grid>
      <Grid x:Name="ResultIndex" Margin="0,26,0,0" Visibility="Collapsed" SizeChanged="ResultIndexSizeChanged">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
       </Grid.RowDefinitions>
       <ScrollViewer x:Name="ResultIndexTools" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="440">
        <StackPanel>
         <Button x:Name="OverviewButton" Content="전체 결과" Click="OverviewClicked" IsEnabled="False" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Margin="0,0,0,8" />

         <StackPanel>
          <TextBlock Text="실험" Style="{StaticResource IndexCaption}" />
          <ListBox x:Name="ChartExperiment" Style="{StaticResource IndexList}" SelectionChanged="ChartExperimentChanged" AutomationProperties.Name="결과 실험 선택">
           <ListBox.ItemTemplate>
            <DataTemplate>
             <TextBlock Text="{Binding Converter={StaticResource ExperimentLabel}}" TextWrapping="Wrap" />
            </DataTemplate>
           </ListBox.ItemTemplate>
          </ListBox>
         </StackPanel>
         <StackPanel Margin="0,10,0,8">
          <TextBlock Text="조건" Style="{StaticResource IndexCaption}" />
          <ListBox x:Name="ChartCondition" Style="{StaticResource ConditionIndexList}" SelectionChanged="ChartSelectionChanged" PreviewMouseLeftButtonUp="ConditionIndexClicked" PreviewKeyDown="ConditionIndexKeyDown" AutomationProperties.Name="그래프 실험 조건">
           <ListBox.ItemTemplate>
            <DataTemplate>
             <TextBlock Text="{Binding Condition}" TextWrapping="Wrap" />
            </DataTemplate>
           </ListBox.ItemTemplate>
          </ListBox>
         </StackPanel>
         <Expander x:Name="TrialFiltersExpander" Header="버전·상태 필터" Margin="0,3,0,3">
          <StackPanel Margin="0,6,0,8">
           <ComboBox Visibility="Collapsed" x:Name="ExperimentFilter" MinWidth="110" MinHeight="34" Margin="0,0,0,6" SelectionChanged="TrialFilterChanged" AutomationProperties.Name="실험 필터" />
           <ComboBox x:Name="ReleaseFilter" MinWidth="0" MinHeight="34" Margin="0,0,0,6" SelectionChanged="TrialFilterChanged" AutomationProperties.Name="버전 필터" />
           <ComboBox x:Name="StatusFilter" MinWidth="0" MinHeight="34" Margin="0,0,0,6" SelectionChanged="TrialFilterChanged" AutomationProperties.Name="상태 필터">
            <ComboBoxItem Content="전체 상태" Tag="" />
            <ComboBoxItem Content="실패" Tag="failed" />
            <ComboBoxItem Content="중단" Tag="cancelled" />
            <ComboBoxItem Content="정리 실패" Tag="cleanup-failed" />
            <ComboBoxItem Content="미수행" Tag="not-run" />
            <ComboBoxItem Content="통계 제외" Tag="excluded" />
            <ComboBoxItem Content="성공" Tag="success" />
           </ComboBox>
           <Button x:Name="ClearTrialFiltersButton" Content="필터 초기화" Click="ClearFiltersClicked" Margin="0,0,0,6" IsEnabled="False" Style="{StaticResource QuietButton}" ToolTip="시행 목록의 필터만 해제합니다. 위의 집계와 벤치 설정은 유지합니다." />
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
       <ListBox x:Name="TrialIndex" Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource IndexList}" ItemTemplate="{StaticResource TrialIndexTemplate}" SelectionChanged="TrialIndexSelected" AutomationProperties.Name="결과 시행 번호 목록" />
       <TextBlock x:Name="TrialScope" Grid.Row="3" Text="기록을 선택하세요." TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="4,8,0,0" FontSize="11" />
       <StackPanel Grid.Row="1" Margin="0,10,0,4">
        <TextBlock Text="개별 시행" Style="{StaticResource IndexCaption}" />
        <TextBlock x:Name="SelectedConditionCaption" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" />
        <Grid>
         <TextBox Height="36" MinHeight="36" x:Name="TrialSearch" TextChanged="TrialSearchChanged" ToolTip="원래 시행 번호·버전·상태 검색" AutomationProperties.Name="결과 시행 검색" />
         <TextBlock Text="번호·버전·상태 검색" Margin="10,0" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TrialSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Grid>
       </StackPanel>
      </Grid>
     </Grid>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" Margin="0" Background="{DynamicResource Workspace}" CornerRadius="0" BorderBrush="{DynamicResource Line}" BorderThickness="0"><Grid>
    <TabControl x:Name="Tabs" Style="{StaticResource BenchTabs}" ItemContainerStyle="{StaticResource BenchTab}" SelectionChanged="WorkflowChanged" AutomationProperties.Name="벤치 작업 단계">
     <TabItem Header="준비" ToolTip="Alt+1 · 실험 준비">
      <DockPanel>
       <Border motion:AshaSurface.Edge="Top" DockPanel.Dock="Bottom" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
        <DockPanel>
         <Button x:Name="StartButton" DockPanel.Dock="Right" Content="벤치 시작" Click="RunClicked" Style="{StaticResource SolidAction}" IsEnabled="False" Margin="12,0,0,0" AutomationProperties.AutomationId="LocalBenchmarkStart" />
         <Button x:Name="ResolvePreparationButton" DockPanel.Dock="Right" Content="확인할 설정으로" Click="ResolvePreparationClicked" Style="{StaticResource QuietButton}" Margin="12,0,0,0" Visibility="Collapsed" />
         <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PlanSummary" Text="실험 준비" FontWeight="SemiBold" />
          <TextBlock x:Name="PlanHint" Text="Unity와 비교할 버전을 선택하세요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
         </StackPanel>
        </DockPanel>
       </Border>
       <ScrollViewer x:Name="PreparationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <StackPanel x:Name="PreparationForm">
         <StackPanel Margin="0,24,0,12">
          <TextBlock Text="새 벤치 준비" Style="{StaticResource PageTitle}" />
          <TextBlock Text="대상과 작업을 선택하면, 환경 준비부터 결과 저장까지 이어집니다." Style="{StaticResource Hint}" />
         </StackPanel>
         <Grid x:Name="PreparationColumns">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition x:Name="PreparationSecondColumn" Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel x:Name="PreparationMain">
           <Border Style="{StaticResource Card}">
            <StackPanel x:Name="EditorSection">
             <DockPanel>
              <TextBlock Text="Unity 환경" Style="{StaticResource Heading}" />
             </DockPanel>
             <TextBlock x:Name="EditorStatus" Text="설치된 Unity를 찾고 있습니다." Style="{StaticResource Hint}" />
             <ComboBox x:Name="EditorList" DisplayMemberPath="Label" ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}" SelectionChanged="PreparationChanged" AutomationProperties.Name="실험에 사용할 Unity" />
             <WrapPanel Margin="0,10,0,0">
              <Button Content="다시 찾기" Click="FindEditorsClicked" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
              <Button Content="직접 선택…" Click="BrowseEditorClicked" Style="{StaticResource QuietButton}" />
             </WrapPanel>
             <Expander Header="실험 환경과 분리 범위">
              <TextBlock Style="{StaticResource Hint}" Text="설치·활성화된 Unity를 사용합니다. 매번 프로젝트·임시 파일·패키지 캐시와 프로세스를 새로 만들고 결과를 저장한 뒤 정리합니다.&#xA;Windows 설정·공용 서비스·시스템 캐시는 공유합니다. 첫 호출은 Unity 준비 후 첫 명령이며 PC 전체의 캐시가 비어 있다는 뜻은 아닙니다." />
             </Expander>
            </StackPanel>
           </Border>
           <Border Style="{StaticResource Card}">
            <StackPanel x:Name="ReleaseSection">
             <DockPanel>
             <TextBlock Text="비교 대상" Style="{StaticResource Heading}" />
             </DockPanel>
             <TextBlock x:Name="ReleaseHint" Text="비교할 대상을 선택하세요. 필요한 파일은 시작할 때 준비합니다." Style="{StaticResource Hint}" />
             <ScrollViewer MaxHeight="210" PreviewMouseWheel="NestedScrollWheel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ReleaseList" />
             </ScrollViewer>
             <CheckBox x:Name="IncludeOfficial" Style="{StaticResource TargetChoice}" Checked="OfficialSelectionChanged" Unchecked="OfficialSelectionChanged" AutomationProperties.Name="공식 Unity CLI와 Pipeline 함께 비교">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
