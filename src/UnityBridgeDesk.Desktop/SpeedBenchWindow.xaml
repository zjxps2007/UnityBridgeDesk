             <DataGrid x:Name="Summary" PreviewMouseWheel="NestedScrollWheel" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="SummarySelected">
              <DataGrid.Columns>
               <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="버전" Binding="{Binding Release}" />
               <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="계획" Binding="{Binding Planned}" />
               <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="유효" Binding="{Binding Valid}" />
               <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="제외" Binding="{Binding Excluded}" />
               <DataGridTextColumn ElementStyle="{StaticResource NumberCell}" Header="평균(ms)" Binding="{Binding Mean, StringFormat=N2, TargetNullValue=—}" />
               <DataGridTextColumn ElementStyle="{StaticResource NumberCell}" Header="중앙값(ms)" Binding="{Binding Median, StringFormat=N2, TargetNullValue=—}" />
               <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="평균 95% 구간(ms)" Binding="{Binding ConfidenceRange}" />
              </DataGrid.Columns>
