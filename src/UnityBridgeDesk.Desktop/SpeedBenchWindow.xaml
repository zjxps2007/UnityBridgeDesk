              <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="상태" Binding="{Binding Status}" />
              <DataGridTextColumn ElementStyle="{StaticResource NumberCell}" Header="대표시간(ms)" Binding="{Binding WorkMs, StringFormat=N2, TargetNullValue=—}" />
              <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="오류 구분" Binding="{Binding FailureCategory}" />
              <DataGridTextColumn ElementStyle="{StaticResource ReportCellText}" Header="정리" Binding="{Binding Cleanup}" />
             </DataGrid.Columns>
            </DataGrid>
           </Expander>
