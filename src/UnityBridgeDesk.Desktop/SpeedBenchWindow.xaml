<Window x:Class="UnityBridgeDesk.Desktop.SpeedBenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="UnityBridge Desk · 로컬 속도 벤치" Icon="Assets/desk.ico" Width="1280" Height="880" MinWidth="960" MinHeight="660"
 WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic, Segoe UI" FontSize="12" Background="{DynamicResource Paper}"
 Loaded="WindowLoaded" Closing="WindowClosing">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Paper}" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="20" /><Setter Property="Margin" Value="0,0,0,14" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,10" /><Setter Property="LineHeight" Value="20" /></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
 </Window.Resources>
 <Grid>
  <Grid.Background><ImageBrush ImageSource="Assets/cloud-station.png" Stretch="UniformToFill" /></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>
  <Border Background="{DynamicResource Paper}" Padding="24,12">
   <DockPanel><Button DockPanel.Dock="Right" Content="테마 변경" Click="ThemeClicked" /><Image Source="Assets/desk.ico" Width="30" Height="30" Margin="0,0,12,0" HorizontalAlignment="Left" /><StackPanel><TextBlock Text="BRIDGE DESK" FontFamily="Consolas" FontSize="16" /><TextBlock Text="같은 환경 · 같은 명령 · 버전별 속도 비교" Foreground="{DynamicResource Muted}" /></StackPanel></DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="24,18,24,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
   <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0,14,0,0" ItemContainerStyle="{StaticResource SelectionTab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <TabItem Header="1  준비" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><DockPanel>
     <Border DockPanel.Dock="Bottom" Background="{DynamicResource Paper}" CornerRadius="12" Padding="12" Margin="0,10,12,0">
      <Button Content="벤치 시작" Click="RunClicked" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsEnabled, ElementName=PreparationForm}" AutomationProperties.AutomationId="LocalBenchmarkStart" />
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
     <StackPanel x:Name="PreparationForm">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="비교할 릴리스" Style="{StaticResource Heading}" />
       <TextBlock Text="정식·RC 릴리스를 함께 비교할 수 있습니다. 두 개 이상 선택하면 CLI·필요한 런타임·Connector를 앱이 받아 검증합니다." Style="{StaticResource Hint}" />
       <WrapPanel><Button Content="릴리스 새로 확인" Click="ReleasesClicked" Margin="0,0,8,8" /><Button Content="선택한 파일 준비" Click="PrepareReleasesClicked" Margin="0,0,8,8" /></WrapPanel>
       <TextBlock x:Name="ReleaseStatus" Text="아직 조회한 릴리스가 없습니다." Style="{StaticResource Hint}" />
       <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ReleaseList" /></ScrollViewer>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="이 PC의 Unity" Style="{StaticResource Heading}" />
       <TextBlock x:Name="EditorStatus" Text="설치된 Unity를 찾고 있습니다." Style="{StaticResource Hint}" />
       <ComboBox x:Name="EditorList" DisplayMemberPath="Label" ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}" MinHeight="36" Margin="0,0,0,12" AutomationProperties.Name="실험에 사용할 Unity" />
       <WrapPanel><Button Content="Unity 다시 찾기" Click="FindEditorsClicked" Margin="0,0,8,8" /><Button Content="실행 파일 선택" Click="BrowseEditorClicked" Margin="0,0,8,8" /></WrapPanel>
       <TextBlock Text="설치·활성화된 Unity를 사용합니다. 새 임시 프로젝트에서 측정하고 결과 저장 후 정리합니다." Style="{StaticResource Hint}" />
       <Expander Header="실험 공간은 어떻게 분리되나요?"><TextBlock Margin="0,10,0,0" Style="{StaticResource Hint}" Text="매번 프로젝트·임시 파일·패키지 캐시를 새로 만들고 Unity·CLI를 새 프로세스로 실행합니다.&#10;Windows 설정·공용 서비스·시스템 캐시는 공유합니다. 첫 호출은 Unity 준비 후 첫 명령이며, PC 전체의 캐시가 비어 있다는 의미는 아닙니다." /></Expander>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <Expander Header="실험 조건 조정 · 첫 실행은 기본값으로 시작할 수 있어요"><StackPanel Margin="0,12,0,0">
       <CheckBox x:Name="F01" Content="F01  첫 호출 / 준비 이후 작은 요청" IsChecked="True" Margin="0,6,0,8" />
       <CheckBox x:Name="F02" Content="F02  같은 1,000개 이동을 1·10·100회로 분할" Margin="0,0,0,8" />
       <CheckBox x:Name="F03" Content="F03  1 KiB·64 KiB·1 MiB 응답" Margin="0,0,0,12" />
       <WrapPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="새 프로젝트 반복" /><TextBox x:Name="Repeats" Text="2" Margin="0,5,0,0" MinHeight="34" /></StackPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="준비 호출" /><TextBox x:Name="Warmups" Text="1" Margin="0,5,0,0" MinHeight="34" /></StackPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="준비 후 측정 호출" /><TextBox x:Name="Calls" Text="3" Margin="0,5,0,0" MinHeight="34" /></StackPanel></WrapPanel>
       <TextBlock Text="예비 시험(Pilot)입니다. 반복 호출을 독립 시행으로 세지 않으며, 작은 표본으로 승자를 판정하지 않습니다." Style="{StaticResource Hint}" />
       <Expander Header="시간 제한·실행 순서"><WrapPanel Margin="0,10,0,0"><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="CLI 제한(초)" /><TextBox x:Name="Timeout" Text="180" Margin="0,5,0,0" /></StackPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="Unity 준비(초)" /><TextBox x:Name="PrepareTimeout" Text="600" Margin="0,5,0,0" /></StackPanel><StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="순서 시드" /><TextBox x:Name="Seed" Text="20260915" Margin="0,5,0,0" /></StackPanel></WrapPanel></Expander>
       <Button x:Name="ResetButton" Content="벤치 설정 초기화" Click="ResetClicked" HorizontalAlignment="Left" Margin="0,12,0,0" />
       </StackPanel></Expander>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer></DockPanel></TabItem>
    <TabItem Header="2  진행" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Border Style="{StaticResource Card}" VerticalAlignment="Stretch"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="시험 진행" Style="{StaticResource Heading}" /><TextBlock Text="임시 프로젝트 준비 → Unity 실행 → 명령 측정 → 결과 저장·정리" Style="{StaticResource Hint}" /></StackPanel>
     <ProgressBar x:Name="Activity" Grid.Row="1" Height="6" Margin="0,0,0,18" IsIndeterminate="False" />
     <TextBox x:Name="Journal" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontFamily="Consolas, Malgun Gothic" />
    </Grid></Border></TabItem>
    <TabItem Header="3  결과" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="저장된 시험" Style="{StaticResource Heading}" /><DockPanel><Button DockPanel.Dock="Right" Content="새로고침" Click="HistoryClicked" Margin="8,0,0,0" /><ComboBox x:Name="History" DisplayMemberPath="Label" SelectionChanged="HistorySelected" MinHeight="36" /></DockPanel><TextBlock x:Name="ResultStatus" Text="아직 시험 결과가 없습니다. 준비 탭에서 시작하세요." Style="{StaticResource Hint}" /></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="조건별 시간과 성공 여부" Style="{StaticResource Heading}" /><TextBlock Text="시간은 성공하고 정리가 확인된 시행 기준입니다. 전체 계획 수와 실패 수를 함께 확인하세요." Style="{StaticResource Hint}" /><DataGrid x:Name="Summary" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="320" HeadersVisibility="Column"><DataGrid.Columns>
      <DataGridTextColumn Header="실험" Binding="{Binding Experiment}" /><DataGridTextColumn Header="조건" Binding="{Binding Condition}" /><DataGridTextColumn Header="버전" Binding="{Binding Release}" /><DataGridTextColumn Header="계획" Binding="{Binding Planned}" /><DataGridTextColumn Header="성공" Binding="{Binding Success}" /><DataGridTextColumn Header="실패" Binding="{Binding Failed}" /><DataGridTextColumn Header="평균" Binding="{Binding Mean, StringFormat=F2}" /><DataGridTextColumn Header="중앙값" Binding="{Binding Median, StringFormat=F2}" /><DataGridTextColumn Header="단위" Binding="{Binding Unit}" />
     </DataGrid.Columns></DataGrid><TextBlock x:Name="Comparison" Style="{StaticResource Hint}" /></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="시행 상세" Style="{StaticResource Heading}" /><TextBox x:Name="TrialDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="230" VerticalScrollBarVisibility="Auto" /><WrapPanel Margin="0,12,0,0"><Button Content="JSON·CSV 결과 폴더" Click="ResultsFolderClicked" Margin="0,0,8,8" /><Button Content="이전 버전 기록 폴더" Click="LegacyFolderClicked" Margin="0,0,8,8" /></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <StackPanel Grid.Column="1" Margin="22,6,0,0">
    <TextBlock x:Name="Clock" FontFamily="Segoe UI Light" FontSize="48" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" /><TextBlock x:Name="Date" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,24" />
    <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="지금 할 일" FontWeight="SemiBold" /><TextBlock x:Name="NextStep" Text="Unity를 찾고 릴리스를 준비합니다." Style="{StaticResource Hint}" /><TextBlock x:Name="State" Text="준비 대기" TextWrapping="Wrap" Foreground="{DynamicResource AccentInk}" /><Button x:Name="CancelButton" Content="중단하고 정리" Click="CancelClicked" Visibility="Collapsed" Margin="0,16,0,0" /></StackPanel></Border>
    <Border Style="{StaticResource Card}" Padding="16"><StackPanel><Image x:Name="MascotImage" Source="Assets/desk.ico" Width="74" Height="74" Margin="0,4,0,10" RenderOptions.BitmapScalingMode="HighQuality" /><TextBlock Text="매번 새 프로젝트로 측정합니다.&#10;정리에 실패하면 다음 시행을 멈춥니다." Style="{StaticResource Hint}" /><TextBlock Text="파일·프로세스 분리 · Windows 공유" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{DynamicResource AccentInk}" /></StackPanel></Border>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource Paper}" Padding="24,8"><TextBlock Text="CLI + Connector 릴리스 비교 · local-cli-completion-v1-pilot · 환경 정보와 정리 상태 기록" Foreground="{DynamicResource Muted}" /></Border>
 </Grid>
</Window>
