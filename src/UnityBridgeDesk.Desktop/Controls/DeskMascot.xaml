<UserControl x:Class="UnityBridgeDesk.Desktop.Controls.DeskMascot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:UnityBridgeDesk.Desktop.Controls"
 Focusable="True" Cursor="Hand" Background="Transparent"
 AutomationProperties.Name="아라 · 클릭 또는 Enter로 반응 보기, 끌어서 자리 옮기기"
 ToolTip="아라 · 클릭하면 반응해요. 끌어서 자리를 옮길 수 있어요.">
 <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="3">
  <Grid IsHitTestVisible="False" RenderTransformOrigin="0.5,0.92">
   <Grid.RenderTransform>
    <TransformGroup>
     <ScaleTransform x:Name="Facing" />
     <ScaleTransform x:Name="BodyScale" />
     <RotateTransform x:Name="BodyTurn" />
     <TranslateTransform x:Name="BodyLift" />
    </TransformGroup>
   </Grid.RenderTransform>
   <local:AshaSprite x:Name="Sprite" RenderOptions.BitmapScalingMode="HighQuality" />
  </Grid>
 </Border>
</UserControl>
