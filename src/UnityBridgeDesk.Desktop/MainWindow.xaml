<Window x:Class="UnityBridgeDesk.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="UnityBridge Desk" Icon="Assets/desk.ico" Width="1280" Height="860" MinWidth="760" MinHeight="560"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="{DynamicResource Paper}" FontFamily="Malgun Gothic, Segoe UI" FontSize="12"
 UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="ShellKeyDown" Closing="WindowClosing" SizeChanged="WindowSizeChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="ToolTabStyle" TargetType="TabItem" BasedOn="{StaticResource SelectionTab}">
   <Setter Property="Padding" Value="14,8" /><Setter Property="MinWidth" Value="118" /><Setter Property="Height" Value="44" />
  </Style>
  <Style x:Key="SidebarCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Paper}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" />
   <Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="14" /><Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="SidebarCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="TextWrapping" Value="Wrap" />
  </Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
  <Grid x:Name="RootGrid" SizeChanged="RootSizeChanged" PreviewMouseDown="WorkspacePointerPressed">
   <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
   <Border Background="{DynamicResource Paper}" CornerRadius="11,11,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="AppTitleMouseDown">
    <Grid Margin="18,0,8,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
      <Image Width="25" Height="25" Source="Assets/desk.ico" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality" />
      <TextBlock Text="BRIDGE DESK" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" />
     </StackPanel>
     <Button x:Name="TargetButton" Grid.Column="1" Click="CatalogClick" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" Padding="10,6" AutomationProperties.Name="프로젝트와 버전 보관함 열기"><TextBlock x:Name="TargetLabel" Text="보관함" TextTrimming="CharacterEllipsis" MaxWidth="230" /></Button>
     <Button Grid.Column="2" Content="테마" Click="CustomizeClick" Padding="12,6" VerticalAlignment="Center" Margin="0,0,10,0" />
     <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="−" Style="{StaticResource CaptionButton}" Click="AppMinimizeClick" ToolTip="프로그램 최소화" AutomationProperties.Name="프로그램 최소화" />
      <Button Content="□" Style="{StaticResource CaptionButton}" Click="AppMaximizeClick" ToolTip="프로그램 최대화·복원" AutomationProperties.Name="프로그램 최대화·복원" />
      <Button Content="×" Style="{StaticResource CaptionButton}" Click="AppCloseClick" ToolTip="프로그램 종료" AutomationProperties.Name="프로그램 종료" />
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1" ClipToBounds="True">
    <Grid.Background><DynamicResource ResourceKey="DeskWallpaper" /></Grid.Background>
    <Border Background="#16FFFFFF" IsHitTestVisible="False" />
    <Grid Margin="24,16,24,32">
     <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="SelectorTrigger" Click="SelectorClick" MouseEnter="SelectorTriggerEntered" MouseLeave="SelectorPointerLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="14,7" ToolTip="포인터를 올려 도구 선택 · 클릭 또는 Enter로 열기" AutomationProperties.Name="도구 선택 열기">
       <StackPanel Orientation="Horizontal"><TextBlock Text="도구" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" /><TextBlock x:Name="SelectedToolLabel" Text="벤치마크" Foreground="{DynamicResource AccentInk}" /><TextBlock Text="⌄" Margin="14,0,0,0" /></StackPanel>
      </Button>
      <Button x:Name="LauncherButton" Grid.Column="1" Click="LauncherClick" Content="도구 찾기" Padding="12,8" VerticalAlignment="Center" ToolTip="Ctrl+K" AutomationProperties.Name="런처 열기" />
     </Grid>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid x:Name="ToolHost" KeyboardNavigation.TabNavigation="Local" />
      <Grid x:Name="Widgets" Grid.Column="1" Width="210" Margin="22,12,0,0">
       <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <StackPanel x:Name="ClockWidget" Margin="0,0,0,28" HorizontalAlignment="Center"><TextBlock x:Name="ClockText" FontFamily="Segoe UI Light" FontSize="48" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" /><TextBlock x:Name="DateText" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" /></StackPanel>
       <ScrollViewer x:Name="SidebarScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
        <StackPanel>
         <Border Style="{StaticResource SidebarCard}" AutomationProperties.Name="현재 작업 요약">
          <StackPanel>
           <TextBlock x:Name="SidebarHeading" Text="작업 요약" Style="{StaticResource SidebarCaption}" Margin="0,0,0,8" />
           <TextBlock x:Name="SidebarProject" Text="프로젝트 미선택" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
           <TextBlock x:Name="SidebarReleases" Text="버전 미선택" FontSize="11" Foreground="{DynamicResource AccentInk}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,5,0,9" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
           <TextBlock x:Name="SidebarCount" Text="조건을 선택해 주세요" FontSize="18" Foreground="{DynamicResource AccentInk}" Margin="0,0,0,6" />
           <TextBlock x:Name="SidebarDetail" TextWrapping="Wrap" FontSize="11" MaxHeight="56" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
           <ProgressBar x:Name="SidebarProgress" Height="5" Minimum="0" Maximum="1" Value="0" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{DynamicResource AccentInk}" Background="{DynamicResource Tint}" />
           <TextBlock x:Name="SidebarElapsed" Style="{StaticResource SidebarCaption}" Visibility="Collapsed" Margin="0,7,0,0" />
           <TextBlock x:Name="SidebarHint" Style="{StaticResource SidebarCaption}" Margin="0,10,0,0" />
           <Button x:Name="SidebarProgressButton" Content="진행 화면 열기 →" Click="SidebarProgressClick" Visibility="Collapsed" Margin="0,10,0,0" Padding="8,7" />
          </StackPanel>
         </Border>
         <Border Style="{StaticResource SidebarCard}" AutomationProperties.Name="최근 작업 결과">
          <StackPanel>
           <Grid><TextBlock x:Name="SidebarRecentHeading" Text="최근 벤치 결과" Style="{StaticResource SidebarCaption}" VerticalAlignment="Center" /><Button x:Name="SidebarRefresh" Content="↻" Click="SidebarRefreshClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="5,0" MinWidth="24" MinHeight="24" ToolTip="최근 기록 새로고침" AutomationProperties.Name="최근 기록 새로고침" /></Grid>
           <TextBlock x:Name="SidebarRecentTitle" Text="기록을 불러오는 중…" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0" />
           <TextBlock x:Name="SidebarRecentDate" Style="{StaticResource SidebarCaption}" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,5,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
           <TextBlock x:Name="SidebarRecentCounts" Text="완료한 결과가 이곳에 모여요." Style="{StaticResource SidebarCaption}" Margin="0,7,0,0" />
           <Button x:Name="SidebarResultButton" Content="결과 열기 →" Click="SidebarResultClick" IsEnabled="False" HorizontalAlignment="Stretch" Padding="8,7" Margin="0,11,0,0" />
          </StackPanel>
         </Border>
        </StackPanel>
       </ScrollViewer>
       <Border x:Name="Companion" Grid.Row="2" Background="Transparent" Padding="0,6,0,4" MouseEnter="CompanionEntered" MouseLeave="CompanionLeft" AutomationProperties.Name="구름 고양이 · 작업 상태 마스코트">
        <StackPanel>
         <Viewbox Width="132" Height="82" Stretch="Uniform">
          <Canvas Width="150" Height="92">
           <Ellipse Width="92" Height="10" Canvas.Left="29" Canvas.Top="79" Fill="{DynamicResource AccentInk}" Opacity="0.12" />
           <Canvas x:Name="CompanionFigure" Width="150" Height="86" RenderTransformOrigin="0.5,0.85">
            <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="CompanionScale" /><RotateTransform x:Name="CompanionTilt" /><TranslateTransform x:Name="CompanionLift" /></TransformGroup></Canvas.RenderTransform>
            <Path Data="M104,70 C132,76 139,57 124,54 C117,53 119,63 114,62" Stroke="{DynamicResource AccentInk}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path Data="M31,69 C22,60 28,43 34,37 L34,14 Q34,9 39,13 L56,27 Q72,22 86,27 L102,14 Q107,10 108,17 L107,40 C120,56 114,76 99,78 L44,78 Q35,78 31,69 Z" Fill="{DynamicResource Paper}" Stroke="{DynamicResource AccentInk}" StrokeThickness="2.5" StrokeLineJoin="Round" />
            <Path Data="M39,20 L40,34 L50,29 Z M102,21 L94,30 L102,35 Z" Fill="{DynamicResource Rose}" />
            <Ellipse Width="13" Height="6" Canvas.Left="39" Canvas.Top="57" Fill="{DynamicResource Rose}" /><Ellipse Width="13" Height="6" Canvas.Left="91" Canvas.Top="57" Fill="{DynamicResource Rose}" />
            <Path x:Name="CompanionEyes" Data="M53,48 L53,51 M89,48 L89,51" Stroke="{DynamicResource AccentInk}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="CompanionMouth" Data="M63,59 Q67,65 71,59 Q75,65 79,59" Stroke="{DynamicResource AccentInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path Data="M115,20 L118,27 L125,30 L118,33 L115,40 L112,33 L105,30 L112,27 Z" Fill="{DynamicResource Accent}" />
           </Canvas>
          </Canvas>
         </Viewbox>
         <TextBlock x:Name="CompanionCaption" Text="같은 시작점, 나란한 결과." FontSize="11" Foreground="{DynamicResource AccentInk}" TextAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
       </Border>
      </Grid>
     </Grid>
     <!-- Only this selection strip slides. The current work surface keeps its size and position. -->
     <Border x:Name="SelectorDropdown" Grid.RowSpan="2" Panel.ZIndex="50" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,34,0,0" Padding="8" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Visibility="Hidden" MouseEnter="SelectorPointerEntered" MouseLeave="SelectorPointerLeft">
      <TabControl x:Name="ToolTabs" ItemContainerStyle="{StaticResource ToolTabStyle}" SelectionChanged="ToolTabChanged" PreviewMouseLeftButtonDown="ToolTabPressed" PreviewKeyDown="SelectorKeyDown" LostKeyboardFocus="SelectorFocusLeft" AutomationProperties.Name="도구 선택 패널">
       <TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="{DynamicResource Tint}" CornerRadius="13" Padding="3"><UniformGrid Rows="1" IsItemsHost="True" /></Border></ControlTemplate></TabControl.Template>
       <TabItem x:Name="InstallTab" Tag="Installation" AutomationProperties.Name="설치·관리 탭" ToolTip="Alt+1 · 설치·관리"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" /><TextBlock Text="설치·관리" /><TextBlock x:Name="InstallActivity" Text=" · 진행 중" Foreground="{DynamicResource AccentInk}" Visibility="Collapsed" /></StackPanel></TabItem.Header></TabItem>
       <TabItem x:Name="AiTab" Tag="AiWork" AutomationProperties.Name="AI 작업 탭" ToolTip="Alt+2 · AI 작업"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" /><TextBlock Text="AI 작업" /><TextBlock x:Name="AiActivity" Text=" · 진행 중" Foreground="{DynamicResource AccentInk}" Visibility="Collapsed" /></StackPanel></TabItem.Header></TabItem>
       <TabItem x:Name="BenchTab" Tag="Benchmark" AutomationProperties.Name="벤치마크 탭" ToolTip="Alt+3 · 벤치마크"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" /><TextBlock Text="벤치마크" /><TextBlock x:Name="BenchActivity" Text=" · 진행 중" Foreground="{DynamicResource AccentInk}" Visibility="Collapsed" /></StackPanel></TabItem.Header></TabItem>
      </TabControl>
     </Border>
    </Grid>
    <TextBlock Text="cloud station / pastel edition" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource AccentInk}" Margin="28,0,0,11" VerticalAlignment="Bottom" IsHitTestVisible="False" />
   </Grid>
   <Border Grid.Row="2" Background="{DynamicResource Paper}" CornerRadius="0,0,11,11" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="SaveStatusText" Text="초안·설정 자동 저장" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="ActivityLabel" Grid.Column="1" Text="실행 없음" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource AccentInk}" Margin="12,0" /><TextBlock Grid.Column="2" Text="Alt 1–3  도구 탭    Ctrl Tab  다음 탭" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" /></Grid></Border>
   <Border x:Name="RecoveryNotice" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,72,20,0" Background="{DynamicResource Peach}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed" Panel.ZIndex="10000"><StackPanel><TextBlock x:Name="RecoveryText" MaxWidth="540" TextWrapping="Wrap" /><Button Content="현재 설정과 초안으로 저장" Click="RecoverySaveClick" Margin="0,8,0,0" /></StackPanel></Border>
   <Grid x:Name="Overlay" Grid.RowSpan="3" Background="#3540384E" Visibility="Collapsed" Panel.ZIndex="20000" MouseDown="OverlayMouseDown" KeyboardNavigation.TabNavigation="Cycle">
    <Border x:Name="OverlayCard" Width="430" MaxHeight="620" Padding="24" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" VerticalAlignment="Center" HorizontalAlignment="Center"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Margin="0,0,0,20"><TextBlock x:Name="OverlayTitle" Text="도구 찾기" FontSize="20" FontWeight="SemiBold" /><Button Content="×" Click="OverlayCloseClick" HorizontalAlignment="Right" Style="{StaticResource CaptionButton}" AutomationProperties.Name="패널 닫기" /></Grid>
     <StackPanel x:Name="LauncherPanel"><TextBox x:Name="LauncherSearch" AutomationProperties.Name="도구 검색" TextChanged="LauncherSearchChanged" KeyDown="LauncherSearchKeyDown" Margin="0,0,0,16" /><StackPanel x:Name="LauncherResults" /><TextBlock Text="도구 이름으로 검색 · Enter 이동 · Esc 닫기" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,16,0,0" /></StackPanel>
     <StackPanel x:Name="CustomizePanel" Visibility="Collapsed">
      <TextBlock Text="작업실의 색" FontWeight="SemiBold" Margin="0,0,0,12" /><UniformGrid Columns="3" Margin="0,0,0,22"><Button x:Name="LilacButton" Content="라일락" Tag="Lilac" Background="#DCCCF1" Click="PaletteClick" Margin="0,0,5,0" Padding="8,16" /><Button Content="로즈" Tag="Rose" Background="#F0C9D8" Click="PaletteClick" Margin="5,0" Padding="8,16" /><Button Content="민트" Tag="Mint" Background="#C5E7DA" Click="PaletteClick" Margin="5,0,0,0" Padding="8,16" /></UniformGrid>
      <CheckBox x:Name="ShowClockCheck" Content="시계와 날짜" Checked="WidgetsChanged" Unchecked="WidgetsChanged" />
      <TextBlock Text="작은 창에서는 오른쪽 보조 영역을 접어&#10;작업 화면을 넓게 보여 줍니다." Style="{StaticResource MutedText}" FontSize="11" Margin="0,12" />
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,18,0,0"><TextBlock Text="Alt+1·2·3  설치·관리 / AI 작업 / 벤치마크&#10;Ctrl+Tab  다음 도구 · Ctrl+Shift+Tab  이전 도구&#10;Ctrl+K  도구 찾기 · Esc  선택 패널 닫기" Style="{StaticResource MutedText}" FontSize="11" /></Border>
     </StackPanel>
    </StackPanel></ScrollViewer></Border>
   </Grid>
  </Grid>
 </Border>
</Window>
