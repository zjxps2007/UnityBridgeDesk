<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:UnityBridgeDesk.Desktop.Controls">
 <SolidColorBrush x:Key="Workspace" Color="#FCFBFE" />
 <SolidColorBrush x:Key="NavigationSurface" Color="#F4F1F8" />
 <SolidColorBrush x:Key="ProblemInk" Color="#9E344D" />
 <Style x:Key="PageTitle" TargetType="TextBlock">
  <Setter Property="motion:AshaSurface.Edge" Value="Top" />
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="FontSize" Value="24" />
  <Setter Property="FontWeight" Value="SemiBold" />
  <Setter Property="TextWrapping" Value="Wrap" />
 </Style>
 <Style x:Key="Eyebrow" TargetType="TextBlock">
  <Setter Property="FontSize" Value="11" />
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="Margin" Value="0,0,0,6" />
 </Style>
 <Style x:Key="SolidAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
  <Setter Property="Background" Value="{DynamicResource AccentInk}" />
  <Setter Property="Foreground" Value="{DynamicResource Paper}" />
  <Setter Property="Padding" Value="20,10" />
  <Setter Property="MinHeight" Value="42" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="6">
      <Grid>
       <Border x:Name="Hover" Background="{DynamicResource Paper}" CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
       <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Hover" Property="Opacity" Value="0.1" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="Hover" Property="Opacity" Value="0.18" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.4" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Ink}" />
       <Setter TargetName="Fill" Property="BorderThickness" Value="2" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ResultMode" TargetType="RadioButton">
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="Padding" Value="14,8" />
  <Setter Property="MinHeight" Value="36" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="RadioButton">
     <Border x:Name="Surface" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
      <Grid>
       <Border x:Name="Selection" Background="{DynamicResource Tint}" CornerRadius="4" Opacity="0" IsHitTestVisible="False" />
       <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Selection" Property="Opacity" Value="1" />
       <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
       <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Line}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentInk}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <SolidColorBrush x:Key="HeaderPaper" Color="#E8FCFBFE" />
 <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="9,10" /><Setter Property="MinHeight" Value="36" /></Style>
 <Style x:Key="SettingsTab" TargetType="TabItem">
  <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  <Setter Property="MinWidth" Value="92" /><Setter Property="MinHeight" Value="40" />
  <Setter Property="FontWeight" Value="Normal" /><Setter Property="Cursor" Value="Hand" />
  <Setter Property="FocusVisualStyle" Value="{StaticResource SidebarToggleFocus}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Grid Background="Transparent">
    <Border x:Name="Hover" Background="Transparent" CornerRadius="5" Margin="2,2,2,5" />
    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,8" />
    <Border x:Name="Mark" Background="Transparent" Height="2" VerticalAlignment="Bottom" Margin="16,0" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="{DynamicResource Tint}" /></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Mark" Property="Background" Value="{DynamicResource AccentInk}" /><Setter Property="Foreground" Value="{DynamicResource AccentInk}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsTabs" TargetType="TabControl">
  <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTab}" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <Grid KeyboardNavigation.TabNavigation="Local">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True" Margin="20,0" /></Border>
    <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ScreenChoice" TargetType="RadioButton">
  <Setter Property="Width" Value="174" /><Setter Property="Margin" Value="0,0,12,12" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Cursor" Value="Hand" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Outline" CornerRadius="8" BorderThickness="2" Padding="3" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Paper}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentInk}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderThickness" Value="3" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Background" Value="{DynamicResource Tint}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
