<UserControl x:Class="UnityBridgeDesk.Desktop.Tools.ToolFrame"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="False" GotKeyboardFocus="RememberFocus" IsTabStop="False">
 <Border x:Name="FrameBorder" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource AccentInk}" BorderThickness="1" CornerRadius="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <ScrollViewer x:Name="DraftSurface" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,18,22,20">
    <StackPanel>
     <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="Eyebrow" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center" />
      <Border Grid.Column="1" Background="{DynamicResource Mint}" Padding="9,5" CornerRadius="5"><TextBlock x:Name="ReadyChip" Text="준비 중" FontSize="10" /></Border>
     </Grid>
     <TextBlock x:Name="Headline" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,7" />
     <TextBlock x:Name="Subtitle" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,20" />
     <Border Style="{StaticResource Card}" Background="{DynamicResource Tint}" Margin="0,0,0,16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="새 작업의 공통 프로젝트" FontSize="10" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="ProjectValue" Text="아직 선택하지 않았어요" FontSize="12" Margin="0,6,8,0" TextWrapping="Wrap" /></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock x:Name="SecondFieldLabel" Text="연결 상태" FontSize="10" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="SecondFieldValue" Text="연결 준비 중" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
       <Button Grid.Row="1" Grid.ColumnSpan="2" Content="프로젝트 · 버전 선택 ↗" Click="CatalogClick" HorizontalAlignment="Left" Padding="10,5" Margin="0,12,0,0" />
      </Grid>
     </Border>
     <Grid x:Name="ModesPanel" Margin="0,0,0,18" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12"><StackPanel>
       <CheckBox x:Name="FixedMode" Content="고정 명령" AutomationProperties.AutomationId="FixedMode" Checked="ModesChanged" Unchecked="ModesChanged" />
       <TextBlock Text="같은 명령을 그대로 재생" FontSize="11" Style="{StaticResource MutedText}" />
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12"><StackPanel>
       <CheckBox x:Name="AiMode" Content="AI 제작" AutomationProperties.AutomationId="AiMode" Checked="ModesChanged" Unchecked="ModesChanged" />
       <TextBlock Text="같은 자연어 지시로 제작" FontSize="11" Style="{StaticResource MutedText}" />
      </StackPanel></Border>
     </Grid>
     <TextBlock x:Name="InputLabel" Text="입력 초안" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
     <Grid>
      <TextBox x:Name="DraftInput" MinHeight="102" MaxHeight="260" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="32000" TextChanged="DraftChanged" />
      <TextBlock x:Name="Placeholder" Margin="13,11" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" IsHitTestVisible="False" />
     </Grid>
     <TextBlock x:Name="DraftHint" Text="이 기기에 초안으로 저장됩니다." FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,7,0,18" />
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
      <TextBlock x:Name="Availability" Style="{StaticResource MutedText}" FontSize="11" />
     </Border>
    </StackPanel>
   </ScrollViewer>
   <DockPanel x:Name="ExecutionSurface" Visibility="Collapsed" Margin="8">
    <Button x:Name="BackToDraftButton" DockPanel.Dock="Top" Content="← 초안으로" HorizontalAlignment="Left" Margin="4,0,0,8" Padding="9,4" Click="BackToDraftClick" />
    <ContentControl x:Name="ExecutionHost" />
   </DockPanel>
   <Border x:Name="DraftActions" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Tint}" CornerRadius="0,0,11,11" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBlock Text="실행 조건을 확인한 뒤 시작합니다." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
     <Button x:Name="ExecuteButton" Grid.Column="1" Content="실행 구성 열기" Click="ExecuteClick" Style="{StaticResource PrimaryButton}" />
    </Grid>
   </Border>
  </Grid>
 </Border>
</UserControl>
